<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outer shadow / glow -->
    <path
        android:pathData="M54,25 L77,35 C77,57 67,72 54,81 C41,72 31,57 31,35 Z"
        android:fillColor="#155E75"
        android:fillAlpha="0.3" />

    <!-- Main Security Shield Body -->
    <path android:pathData="M54,27 L75,36 C75,56 65,70 54,79 C43,70 33,56 33,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="27"
                android:endX="75"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#2DD4BF" />
                <item android:offset="0.4" android:color="#14B8A6" />
                <item android:offset="1.0" android:color="#0F766E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shield Inner Bevel Edge -->
    <path
        android:pathData="M54,31 L71,39 C71,55 63,66 54,74 C45,66 37,55 37,39 Z"
        android:fillColor="#042F2E" />

    <!-- Emergency Cross in Shield Upper / Center -->
    <path
        android:pathData="M51,37 H57 V45 H65 V51 H57 V59 H51 V51 H43 V45 H51 Z"
        android:fillColor="#EF4444" />

    <path
        android:pathData="M52,38 H56 V46 H64 V50 H56 V58 H52 V50 H44 V46 H52 Z"
        android:fillColor="#F87171" />

    <!-- Vault Padlock Shackle -->
    <path
        android:pathData="M48,58 C48,54.7 50.7,52 54,52 C57.3,52 60,54.7 60,58 V62 H48 Z"
        android:strokeColor="#FCD34D"
        android:strokeWidth="2.5"
        android:fillColor="#00000000" />

    <!-- Vault Padlock Body -->
    <path
        android:pathData="M45,62 H63 V72 H45 Z"
        android:fillColor="#F59E0B" />

    <!-- Padlock Keyhole -->
    <path
        android:pathData="M54,64 A1.8,1.8 0 1 0 54,67.6 L54.7,70 H53.3 L54,67.6 Z"
        android:fillColor="#78350F" />

</vector>
