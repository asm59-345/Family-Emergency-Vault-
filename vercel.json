{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/app-debug.apk",
      "dest": "/public/app-debug.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=app-debug.apk"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
