{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/app-debug.apk",
      "dest": "/public/app-debug.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=FamilyEmergencyVault-v1.0.apk",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
