{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/(public/)?app-debug\\.apk$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=FamilyEmergencyVault-Preview-debug.apk",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/(public/)?manifest\\.json$",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "continue": true
    },
    {
      "src": "^/public/(.*)",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
